# === Application Configuration ===
APP_ENV=development
APP_PORT=8000
APP_DEBUG=True

# === Google Sheets Integration ===
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_DEFAULT_WORKSHEET=

# === Moodle Integration ===
MOODLE_BASE_URL=
MOODLE_TOKEN=
MOODLE_DEFAULT_ROLE_ID=

# === Moodle Log Ingestion ===
# Dùng connection read-only tới database/log store Moodle thật.
# Không commit giá trị thật lên Git.
MOODLE_LOG_SOURCE_DATABASE_URL=
MOODLE_LOG_SOURCE_NAME=moodle_standard_log
MOODLE_LOG_SOURCE_TABLE=mdl_logstore_standard_log
MOODLE_LOG_SOURCE_USER_TABLE=mdl_user
MOODLE_LOG_SOURCE_COURSE_TABLE=mdl_course
# Có thể giới hạn course, ví dụ: 12,42246. Để trống nếu muốn lấy tất cả log nguồn.
MOODLE_LOG_SOURCE_POLL_COURSE_IDS=
MOODLE_LOG_SOURCE_BATCH_SIZE=1000

# === Moodle UI Log Export Automation ===
# Dùng khi không có quyền truy cập database/server Moodle.
# Script Playwright sẽ đăng nhập Moodle UI và tải file Logs export về local.
MOODLE_UI_BASE_URL=
MOODLE_UI_USERNAME=
MOODLE_UI_PASSWORD=
MOODLE_UI_LOGIN_PATH=/login/index.php
MOODLE_LOGS_PATH=/report/log/index.php
MOODLE_LOG_COURSE_ID=12
MOODLE_LOG_EXPORT_LOOKBACK_MINUTES=120
MOODLE_LOG_EXPORT_FORMAT=csv
MOODLE_LOG_EXPORT_HEADLESS=true
MOODLE_LOG_AUTO_IMPORT=true
THINKSPACE_APP_BASE_URL=http://localhost:8080

# === Live Analytics Refresh ===
# Dung de chay dbt tren Neon/Render dashboard demo.
# Khong commit connection string that len Git.
TARGET_DATABASE_URL=
RENDER_APP_BASE_URL=https://thinkspace-management.onrender.com

# === PostgreSQL Configuration ===
POSTGRES_USER=myuser
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=mydb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL kết nối chung (thường được các ORM như SQLAlchemy/Django sử dụng)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
