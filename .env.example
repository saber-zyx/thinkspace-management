# === Application Configuration ===
APP_ENV=development
APP_PORT=8000
APP_DEBUG=True

# === Google Sheets Integration ===
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_DEFAULT_WORKSHEET=

# === Moodle Integration ===
MOODLE_BASE_URL=
MOODLE_TOKEN=
MOODLE_DEFAULT_ROLE_ID=

# === PostgreSQL Configuration ===
POSTGRES_USER=myuser
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=mydb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL kết nối chung (thường được các ORM như SQLAlchemy/Django sử dụng)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
